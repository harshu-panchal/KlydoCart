PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DB?retryWrites=true&w=majority

# --- VPS image storage (Phases A–B) ---
# Production: keep STORAGE_ROOT outside the app deploy directory
STORAGE_ROOT=/var/storage
PUBLIC_IMAGE_BASE_URL=https://api.example.com/images

# Local development examples:
# STORAGE_ROOT=./.storage
# PUBLIC_IMAGE_BASE_URL=http://localhost:5000/images

FRONTEND_URL=http://localhost:5173

# Cloudinary retained for rollback / legacy URLs until migration is approved
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
